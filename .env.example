# Companion — environment
#
# Copy to .env and fill in. Never commit a filled-in copy: .env is ignored on
# purpose. On Render every secret below is declared with sync:false in
# render.yaml, which means it is set once in the dashboard and never lives in
# this repository.

# ─── Core ────────────────────────────────────────────────────────────────────

# Public origin. Share links, OAuth callbacks and Stripe returns are built from
# this, so it must match the address recipients actually use.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres 16 with the pgvector extension. The migrator creates the extension,
# so the role needs CREATE EXTENSION rights on first run.
DATABASE_URL=postgres://companion:companion@127.0.0.1:5432/companion_dev
DATABASE_POOL_MAX=10

# Redis. Required for the background worker; without it uploads are accepted
# but never processed.
REDIS_URL=redis://127.0.0.1:6379

# 32+ random characters. Signs recipient session cookies and local storage
# URLs, so rotating it logs every recipient out and invalidates open preview
# links. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────

# The only credential the answer and vision models need. Leave it unset to run
# with keyword-only search: documents still open and index, but questions are
# unavailable and scanned pages are not read.
OPENAI_API_KEY=
# Override only when pointing at a compatible gateway.
OPENAI_BASE_URL=
OPENAI_ANSWER_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ORGANIZATION=

# ─── Storage ─────────────────────────────────────────────────────────────────

# local writes to disk and is for development only. A Render disk is not
# durable storage: it is per-instance and lost on redeploy, which the storage
# durability check reports as a CRITICAL failure. Production uses s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage

# Any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2). The bucket
# must be private: originals are never addressable by a browser.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for R2 or another non-AWS endpoint.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ─── Billing ─────────────────────────────────────────────────────────────────

# Stripe Checkout and the customer portal. Companion does not use Stripe
# Connect. Leave unset to run without billing; plans then fall back to their
# configured entitlements and no checkout is offered.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Price ids, created in Stripe. Prices are never edited in the database: a new
# price means a new Stripe Price object, so existing subscribers keep theirs.
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# ─── Sign-in ─────────────────────────────────────────────────────────────────

# Optional Google sign-in. Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated addresses promoted to Super Admin on seed. This is the only
# bootstrap path to /admin; the role is never inferred from an email domain.
SUPER_ADMIN_EMAILS=

# ─── Email ───────────────────────────────────────────────────────────────────

# SMTP for magic links and recipient identity codes. Without it, codes are
# written to the log in development and identity-gated links cannot be opened
# in production.
SMTP_URL=
EMAIL_FROM=Companion <no-reply@companion.app>

# ─── Worker ──────────────────────────────────────────────────────────────────

WORKER_CONCURRENCY=4
# Reads pages with no usable embedded text using the vision model. There is no
# classical OCR: confidently wrong OCR text poisons retrieval invisibly, while
# a vision read is scored before it reaches the index.
VISION_READING_ENABLED=true
VISION_MAX_PAGES_PER_FILE=400
OPENAI_VISION_MODEL=gpt-5.6-luna
# Transcribes one page per document and compares it against the indexed text,
# which is the only way to catch a preview and an answer describing different
# pages. Costs one extra model call per file.
PREVIEW_TEXT_AUDIT_ENABLED=true

# ─── Observability ───────────────────────────────────────────────────────────

LOG_LEVEL=info
# Set by Render automatically; quality evidence is attributed to it.
# RENDER_GIT_COMMIT=

# ─── Tests ───────────────────────────────────────────────────────────────────

# Integration tests truncate every table, so this must name a database whose
# name ends in _test. The suite refuses to run otherwise.
TEST_DATABASE_URL=postgres://companion:companion@127.0.0.1:5432/companion_test
